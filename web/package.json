{
  "name": "poke-sql-web",
  "private": true,
  "version": "0.1.0",
  "description": "Practice SQL with a local Pokédex database",
  "author": "PokéSQL contributors",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && node scripts/check-assets.mjs && vite build --configLoader runner && node scripts/build-offline.mjs",
    "preview": "vite preview --configLoader runner",
    "sprites": "node ../scripts/vendor_sprites.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && node node_modules/electron/install.js && electron-builder --win portable nsis --x64 --publish never",
    "test": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "build": {
    "appId": "com.pokesql.app",
    "productName": "PokeSQL",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": { "target": ["portable", "nsis"], "icon": "desktop/icon.ico" },
    "portable": { "artifactName": "PokeSQL-${version}-portable.exe" },
    "nsis": { "artifactName": "PokeSQL-${version}-setup.exe", "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "runAfterFinish": false }
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@uiw/react-codemirror": "^4.23.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  }
}
